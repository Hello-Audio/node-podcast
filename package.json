{
  "name": "podcast",
  "version": "1.3.0",
  "description": "Podcast RSS feed generator. A really simple API to add Podcast-RSS feeds to any project.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build",
    "lint": "eslint src test",
    "build": "npm run clean && node esbuild.config.mjs",
    "clean": "rm -rf dist",
    "test": "npm run lint && npm run build && ava"
  },
  "files": [
    "dist/*"
  ],
  "licenses": [
    {
      "type": "MIT",
      "url": "http://github.com/maxnowack/node-podcast/raw/master/LICENSE"
    }
  ],
  "homepage": "http://github.com/Hello-Audio/node-podcast",
  "author": "Hello Audio <developers@helloaudio.fm>",
  "contributors": [
    "Max Nowack <max@unsou.de>",
    "Hello Audio"
  ],
  "repository": {
    "type": "git",
    "url": "http://github.com/Hello-Audio/node-podcast"
  },
  "ava": {
    "concurrency": 5,
    "failFast": true
  },
  "dependencies": {
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "ava": "^6.4.1",
    "esbuild": "0.28.1",
    "eslint": "^9.39.0",
    "globals": "^17.11.0",
    "include-folder": "^1.0.0",
    "mockdate": "^2.0.5"
  }
}
