{
  "name": "podcast",
  "version": "2.0.0",
  "description": "Podcast RSS feed generator. A really simple API to add Podcast-RSS feeds to any project.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.mjs\"",
    "build": "node esbuild.config.mjs",
    "test": "npm run format:check && npm run lint && npm run build && mocha --bail \"test/**/*.mjs\""
  },
  "files": [
    "dist/*"
  ],
  "licenses": [
    {
      "type": "MIT",
      "url": "http://github.com/maxnowack/node-podcast/raw/master/LICENSE"
    }
  ],
  "homepage": "http://github.com/Hello-Audio/node-podcast",
  "author": "Hello Audio <developers@helloaudio.fm>",
  "contributors": [
    "Max Nowack <max@unsou.de>",
    "Hello Audio"
  ],
  "repository": {
    "type": "git",
    "url": "http://github.com/Hello-Audio/node-podcast"
  },
  "dependencies": {
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "chai": "^6.2.2",
    "esbuild": "0.28.1",
    "eslint": "^9.39.0",
    "globals": "^17.11.0",
    "include-folder": "^1.0.0",
    "mocha": "^11.8.0",
    "mockdate": "^2.0.5",
    "prettier": "^3.9.6"
  }
}
